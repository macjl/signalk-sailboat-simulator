{
  "name": "signalk-sailboat-simulator",
  "version": "0.2.0",
  "description": "Signal K plugin that simulates a sailing boat from autopilot turn-rate output, weather and polar performance data.",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "index.js",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk",
    "sailing",
    "simulator",
    "polar",
    "weather",
    "autopilot"
  ],
  "author": "Jean-Laurent Girod (@macjl)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/macjl/signalk-sailboat-simulator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macjl/signalk-sailboat-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/macjl/signalk-sailboat-simulator/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {},
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Sailboat Simulator",
    "recommends": [
      "signalk-autopilot-emulator-v2",
      "signalk-polar-performance-plugin",
      "signalk-derived-data",
      "@signalk/open-meteo-provider",
      "signalk-distance-to-shore"
    ]
  }
}
